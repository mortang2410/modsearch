{
  "name": "@local/modsearch-nous",
  "version": "5.10.5-nous.1",
  "description": "modsearch with an added Perplexity Fast Search engine, served through the Nous Tool Gateway using a Hermes-managed Portal session (no Perplexity API key). Upstream @liustack/modsearch by Leon Liu (MIT); web search, page read, and X search unchanged.",
  "type": "module",
  "bin": {
    "modsearch": "./dist/main.js"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "biome lint",
    "format": "biome format --write",
    "release": "node scripts/release.mjs",
    "prepublishOnly": "pnpm build",
    "eval": "node evals/run.mjs",
    "docs:list": "node scripts/docs-list.js"
  },
  "files": [
    "dist",
    "docs",
    "skills/modsearch/SKILL.md",
    "skills/modsearch/scripts",
    "skills/modsearch/references",
    "dsh",
    "cordis.patch.yml"
  ],
  "keywords": [
    "agent",
    "agent-skill",
    "antigravity",
    "cli",
    "deepseek-harness",
    "dsh-plugin",
    "llm",
    "modsearch",
    "nous",
    "perplexity",
    "search",
    "web-fetch"
  ],
  "author": "fork of Leon Liu (liustack)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liustack/modsearch.git (upstream; fork pending)"
  },
  "bugs": {
    "url": "https://github.com/liustack/modsearch/issues"
  },
  "homepage": "https://github.com/liustack/modsearch#readme",
  "engines": {
    "node": ">=22.13"
  },
  "exports": {
    ".": "./dsh/index.js",
    "./dsh": "./dsh/index.js",
    "./client": "./dsh/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": true
    }
  },
  "dependencies": {
    "commander": "^13.1.0",
    "undici": "^7.29.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/node": "^22.19.7",
    "@vitest/coverage-v8": "3.2.4",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "vitest": "3.2.4"
  }
}
